<Window Style="{DynamicResource {x:Type Window}}" x:Class="FloatingPhrases.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FloatingPhrases"
        Title="Floating Phrases"
        Icon="/FloatingPhrases;component/Assets/app.ico"
        Width="430"
        Height="650"
        MinWidth="370"
        MinHeight="450"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <ResourceDictionary />
    </Window.Resources>

    <Grid>
    <Border x:Name="EdgeHandle" Visibility="Collapsed" Background="{DynamicResource PrimaryBrush}"
            CornerRadius="5" Cursor="Hand" ToolTip="按住拖动；悬停或点击展开，拖离边缘可取消收起"
            AutomationProperties.Name="拖动或展开 Floating Phrases">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="内存" FontSize="10" Foreground="{DynamicResource CardBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EdgeMemoryText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CardBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
    <Border x:Name="MainPanel" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource PanelRadius}"
            Effect="{DynamicResource PanelShadow}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="106" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="{DynamicResource HeaderRadius}">
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="50"/></Grid.RowDefinitions>
                <Grid Margin="18,8,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Floating Phrases" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="短语 · 文件 · 软件 · 待办 · 命令 · 电脑" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="ThemeBox" Width="80" Height="30" Margin="0,0,8,0"
                                  AutomationProperties.Name="界面主题" SelectionChanged="ThemeBox_SelectionChanged">
                            <ComboBoxItem Content="shadcn" /><ComboBoxItem Content="经典" />
                        </ComboBox>
                        <Button x:Name="AddEntryButton" Content="＋" FontSize="20" ToolTip="新增当前类型" Click="Add_Click" Style="{DynamicResource AddEntryButtonStyle}" />
                        <Button Content="—" Style="{DynamicResource IconButton}" FontSize="17" ToolTip="隐藏到托盘" Click="Hide_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="18,0,16,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="ModeBox" Height="30" ToolTip="窗口模式" VerticalContentAlignment="Center" SelectionChanged="ModeBox_SelectionChanged">
                        <ComboBoxItem Content="普通"/><ComboBoxItem Content="悬浮"/><ComboBoxItem Content="穿透"/>
                    </ComboBox>
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Height="24" Margin="14,0,8,0" VerticalAlignment="Center" Minimum="20" Maximum="90" TickFrequency="5" ToolTip="闲置透明度" ValueChanged="OpacitySlider_ValueChanged" />
                    <TextBlock x:Name="OpacityValueText" Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                    <Button Grid.Column="3" Content="截图" Width="44" Style="{DynamicResource IconButton}" FontSize="12" ToolTip="框选截图，画线或画框后复制、另存 PNG" Click="Screenshot_Click"/>
                    <Button Grid.Column="4" Content="翻译" Width="44" Style="{DynamicResource IconButton}" FontSize="12" ToolTip="翻译已复制的英文（Ctrl+T）" Click="Translation_Click"/>
                </Grid>
            </Grid>
            </Border>

            <TabControl x:Name="MainTabs" Grid.Row="1" Margin="12,8,12,0">
                <TabItem Header="常用句子">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,12,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="74" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox"
                                     Style="{DynamicResource SearchBoxStyle}"
                                     TextChanged="SearchBox_TextChanged"
                                     ToolTip="搜索标题、分组或内容" />
                            <TextBlock Text="搜索短语、分组或内容" Foreground="{DynamicResource MutedBrush}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Content="新增" Style="{DynamicResource AddButton}" Click="AddPhrase_Click" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="EmptyHint"
                                       Text="没有匹配的短语"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="PhraseList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,0,4,9">
                                                <Button Tag="{Binding}"
                                                        Style="{DynamicResource CardButton}"
                                                        AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="Item_PreviewMouseMove"
                                                        DragOver="Item_DragOver"
                                                        Drop="Item_Drop"
                                                        ToolTip="点击复制；按住拖动排序"
                                                        Click="Copy_Click">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="●" Foreground="{DynamicResource WarningBrush}" FontSize="9" Margin="0,3,5,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                                            <Border Background="{DynamicResource SecondaryBrush}" CornerRadius="6" Margin="8,0,0,0" Padding="6,1">
                                                                <TextBlock Text="{Binding Group}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Text}" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="⋮⋮" Foreground="{DynamicResource MutedBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,2,0" IsHitTestVisible="False" />
                                                    <Button Content="改" Tag="{Binding}" ToolTip="编辑" Style="{DynamicResource ItemAction}" Click="EditPhrase_Click" />
                                                    <Button Content="删" Tag="{Binding}" ToolTip="删除" Style="{DynamicResource ItemAction}" Foreground="{DynamicResource DestructiveBrush}" Click="DeletePhrase_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="文件" ToolTip="文件夹与 Markdown 快捷入口">
                    <TabControl x:Name="FileTabs" Margin="0,8,0,0" SelectedIndex="0">
                        <TabItem Header="文件夹">
                        <Grid x:Name="FolderPanel">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,12,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="74" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderSearchBox"
                                     Style="{DynamicResource SearchBoxStyle}"
                                     TextChanged="FolderSearchBox_TextChanged"
                                     ToolTip="搜索名称或路径" />
                            <TextBlock Text="搜索文件夹名称或路径" Foreground="{DynamicResource MutedBrush}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FolderSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Content="新增" Style="{DynamicResource AddButton}" Click="AddFolder_Click" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="FolderEmptyHint"
                                       Text="还没有添加文件夹"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="FolderList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,0,4,9">
                                                <Button Tag="{Binding}"
                                                        Style="{DynamicResource CardButton}"
                                                        AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="Item_PreviewMouseMove"
                                                        DragOver="Item_DragOver"
                                                        Drop="Item_Drop"
                                                        ToolTip="点击打开；按住拖动排序"
                                                        Click="OpenFolder_Click">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📁" FontSize="15" Margin="0,0,7,0" />
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="  ●" Foreground="{DynamicResource WarningBrush}" FontSize="9" Margin="3,3,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Path}" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="⋮⋮" Foreground="{DynamicResource MutedBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,2,0" IsHitTestVisible="False" />
                                                    <Button Content="改" Tag="{Binding}" ToolTip="编辑" Style="{DynamicResource ItemAction}" Click="EditFolder_Click" />
                                                    <Button Content="删" Tag="{Binding}" ToolTip="删除" Style="{DynamicResource ItemAction}" Foreground="{DynamicResource DestructiveBrush}" Click="DeleteFolder_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                        </Grid>
                        </TabItem>
                        <TabItem Header="Markdown">
                            <local:DocumentListView x:Name="DocumentView" />
                        </TabItem>
                        <TabItem Header="手机互传">
                            <local:TransferView x:Name="TransferView" />
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem Header="软件" ToolTip="本地软件">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="104" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,10,4,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="38" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="AppSearchBox"
                                     Style="{DynamicResource SearchBoxStyle}"
                                     TextChanged="AppSearchBox_TextChanged"
                                     ToolTip="搜索名称、分类或路径" />
                            <TextBlock Text="搜索软件名称或分类" Foreground="{DynamicResource MutedBrush}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=AppSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="AppCategoryFilter"
                                          Height="38"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="AppCategoryFilter_SelectionChanged" />
                                <Button Grid.Column="2" Content="导入桌面" Height="38" Click="ImportDesktopApps_Click" />
                                <Button Grid.Column="4" Content="新增" Height="38" Style="{DynamicResource AddButton}" Width="64" Click="AddApp_Click" />
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="AppEmptyHint"
                                       Text="还没有添加软件"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="AppList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,0,4,9">
                                                <Button Tag="{Binding}"
                                                        Style="{DynamicResource CardButton}"
                                                        AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="Item_PreviewMouseMove"
                                                        DragOver="Item_DragOver"
                                                        Drop="Item_Drop"
                                                        ToolTip="点击启动；按住拖动排序"
                                                        Click="OpenApp_Click">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="▣" Foreground="{DynamicResource PrimaryBrush}" FontSize="15" Margin="0,0,7,0" />
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                                            <Border Background="{DynamicResource SecondaryBrush}" CornerRadius="6" Margin="8,0,0,0" Padding="6,1">
                                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                                                            </Border>
                                                            <TextBlock Text="  ●" Foreground="{DynamicResource WarningBrush}" FontSize="9" Margin="3,3,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Path}" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="⋮⋮" Foreground="{DynamicResource MutedBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,2,0" IsHitTestVisible="False" />
                                                    <Button Content="改" Tag="{Binding}" ToolTip="编辑" Style="{DynamicResource ItemAction}" Click="EditApp_Click" />
                                                    <Button Content="删" Tag="{Binding}" ToolTip="删除" Style="{DynamicResource ItemAction}" Foreground="{DynamicResource DestructiveBrush}" Click="DeleteApp_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TodoTab" Header="待办清单">
                    <local:TodoListView x:Name="TodoView" />
                </TabItem>
                <TabItem x:Name="CommandTab" Header="命令" ToolTip="保存并在终端运行常用命令">
                    <local:CommandListView x:Name="CommandView" />
                </TabItem>
                <TabItem x:Name="ComputerTab" Header="电脑" ToolTip="电脑状态与系统管理入口">
                    <local:ComputerView x:Name="ComputerView" />
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="{DynamicResource SubtleBrush}" CornerRadius="{DynamicResource FooterRadius}">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText"
                               Text="Ctrl+Alt+Space 显隐 · Ctrl+Alt+T 穿透"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="MemoryText" Grid.Column="1" Text="内存 --"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
    </Grid>
</Window>
