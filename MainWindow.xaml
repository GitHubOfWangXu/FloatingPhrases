<Window x:Class="FloatingPhrases.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FloatingPhrases"
        Title="Floating Phrases"
        Icon="/FloatingPhrases;component/Assets/app.ico"
        Width="430"
        Height="650"
        MinWidth="370"
        MinHeight="450"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#65708A" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ItemAction" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Width" Value="74" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#4462E8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D5DAE7" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Padding" Value="13,11,72,11" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E4EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#F1F4FF" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#AAB7F1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#65708A"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabPill" Background="{TemplateBinding Background}" CornerRadius="8" Padding="4,10" Margin="2,0">
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabPill" Property="Background" Value="#4462E8"/><Setter Property="Foreground" Value="White"/></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="TabPill" Property="Background" Value="#E8EDFC"/></MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <Border x:Name="EdgeHandle" Visibility="Collapsed" Background="#4462E8"
            CornerRadius="5" Cursor="Hand" ToolTip="悬停或点击展开；展开后拖动标题栏离开边缘可取消收起"
            AutomationProperties.Name="展开 Floating Phrases">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="内存" FontSize="10" Foreground="White" HorizontalAlignment="Center" />
            <TextBlock x:Name="EdgeMemoryText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
    <Border x:Name="MainPanel" Background="#F8F9FD"
            BorderBrush="#D9DEEB"
            BorderThickness="1"
            CornerRadius="18"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.22" Color="#17213B" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="106" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Background="#EEF1FA" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="50"/></Grid.RowDefinitions>
                <Grid Margin="18,8,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Floating Phrases" FontSize="17" FontWeight="SemiBold" Foreground="#253047" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="短语 · 文件夹 · 软件 · 待办" FontSize="11" Foreground="#79839A" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="＋" Style="{StaticResource IconButton}" FontSize="20" ToolTip="新增当前类型" Click="Add_Click" />
                        <Button Content="—" Style="{StaticResource IconButton}" FontSize="17" ToolTip="隐藏到托盘" Click="Hide_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="18,0,16,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="ModeBox" Height="30" ToolTip="窗口模式" VerticalContentAlignment="Center" SelectionChanged="ModeBox_SelectionChanged">
                        <ComboBoxItem Content="普通"/><ComboBoxItem Content="悬浮"/><ComboBoxItem Content="穿透"/>
                    </ComboBox>
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Height="24" Margin="14,0,8,0" VerticalAlignment="Center" Minimum="20" Maximum="90" TickFrequency="5" ToolTip="闲置透明度" ValueChanged="OpacitySlider_ValueChanged" />
                    <TextBlock x:Name="OpacityValueText" Grid.Column="2" VerticalAlignment="Center" Foreground="#65708A" FontSize="11"/>
                    <Button Grid.Column="3" Content="截图" Width="44" Style="{StaticResource IconButton}" FontSize="12" ToolTip="框选屏幕区域并复制到剪贴板" Click="Screenshot_Click"/>
                </Grid>
            </Grid>

            <TabControl x:Name="MainTabs" Grid.Row="1" Margin="12,8,12,0" Background="Transparent" BorderThickness="0">
                <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <UniformGrid Rows="1" IsItemsHost="True"/>
                    <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,4,0,0"/>
                </Grid></ControlTemplate></TabControl.Template>
                <TabItem Header="常用句子">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,12,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="74" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource SearchBoxStyle}"
                                     TextChanged="SearchBox_TextChanged"
                                     ToolTip="搜索标题、分组或内容" />
                            <TextBlock Text="搜索短语、分组或内容" Foreground="#8B94A8" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Content="新增" Style="{StaticResource AddButton}" Click="AddPhrase_Click" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="EmptyHint"
                                       Text="没有匹配的短语"
                                       Foreground="#8B94A8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="PhraseList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,0,4,9">
                                                <Button Tag="{Binding}"
                                                        Style="{StaticResource CardButton}"
                                                        AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="Item_PreviewMouseMove"
                                                        DragOver="Item_DragOver"
                                                        Drop="Item_Drop"
                                                        ToolTip="点击复制；按住拖动排序"
                                                        Click="Copy_Click">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="●" Foreground="#F2A93B" FontSize="9" Margin="0,3,5,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#29344D" TextTrimming="CharacterEllipsis" />
                                                            <Border Background="#EDF0F7" CornerRadius="6" Margin="8,0,0,0" Padding="6,1">
                                                                <TextBlock Text="{Binding Group}" FontSize="10" Foreground="#66718A" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Text}" Margin="0,6,0,0" Foreground="#727C91" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="⋮⋮" Foreground="#9AA2B3" FontSize="14" VerticalAlignment="Center" Margin="0,0,2,0" IsHitTestVisible="False" />
                                                    <Button Content="改" Tag="{Binding}" ToolTip="编辑" Style="{StaticResource ItemAction}" Click="EditPhrase_Click" />
                                                    <Button Content="删" Tag="{Binding}" ToolTip="删除" Style="{StaticResource ItemAction}" Foreground="#C24E5B" Click="DeletePhrase_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="文件夹" ToolTip="本地文件夹">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,12,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="74" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderSearchBox"
                                     Style="{StaticResource SearchBoxStyle}"
                                     TextChanged="FolderSearchBox_TextChanged"
                                     ToolTip="搜索名称或路径" />
                            <TextBlock Text="搜索文件夹名称或路径" Foreground="#8B94A8" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FolderSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Content="新增" Style="{StaticResource AddButton}" Click="AddFolder_Click" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="FolderEmptyHint"
                                       Text="还没有添加文件夹"
                                       Foreground="#8B94A8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="FolderList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,0,4,9">
                                                <Button Tag="{Binding}"
                                                        Style="{StaticResource CardButton}"
                                                        AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="Item_PreviewMouseMove"
                                                        DragOver="Item_DragOver"
                                                        Drop="Item_Drop"
                                                        ToolTip="点击打开；按住拖动排序"
                                                        Click="OpenFolder_Click">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📁" FontSize="15" Margin="0,0,7,0" />
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#29344D" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="  ●" Foreground="#F2A93B" FontSize="9" Margin="3,3,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Path}" Margin="0,6,0,0" Foreground="#727C91" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="⋮⋮" Foreground="#9AA2B3" FontSize="14" VerticalAlignment="Center" Margin="0,0,2,0" IsHitTestVisible="False" />
                                                    <Button Content="改" Tag="{Binding}" ToolTip="编辑" Style="{StaticResource ItemAction}" Click="EditFolder_Click" />
                                                    <Button Content="删" Tag="{Binding}" ToolTip="删除" Style="{StaticResource ItemAction}" Foreground="#C24E5B" Click="DeleteFolder_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="软件" ToolTip="本地软件">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="104" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,10,4,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="38" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="AppSearchBox"
                                     Style="{StaticResource SearchBoxStyle}"
                                     TextChanged="AppSearchBox_TextChanged"
                                     ToolTip="搜索名称、分类或路径" />
                            <TextBlock Text="搜索软件名称或分类" Foreground="#8B94A8" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=AppSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="AppCategoryFilter"
                                          Height="38"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="AppCategoryFilter_SelectionChanged" />
                                <Button Grid.Column="2" Content="导入桌面" Height="38" Click="ImportDesktopApps_Click" />
                                <Button Grid.Column="4" Content="新增" Height="38" Style="{StaticResource AddButton}" Width="64" Click="AddApp_Click" />
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="AppEmptyHint"
                                       Text="还没有添加软件"
                                       Foreground="#8B94A8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="AppList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,0,4,9">
                                                <Button Tag="{Binding}"
                                                        Style="{StaticResource CardButton}"
                                                        AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="Item_PreviewMouseMove"
                                                        DragOver="Item_DragOver"
                                                        Drop="Item_Drop"
                                                        ToolTip="点击启动；按住拖动排序"
                                                        Click="OpenApp_Click">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="▣" Foreground="#4462E8" FontSize="15" Margin="0,0,7,0" />
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#29344D" TextTrimming="CharacterEllipsis" />
                                                            <Border Background="#EDF0F7" CornerRadius="6" Margin="8,0,0,0" Padding="6,1">
                                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#66718A" />
                                                            </Border>
                                                            <TextBlock Text="  ●" Foreground="#F2A93B" FontSize="9" Margin="3,3,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Path}" Margin="0,6,0,0" Foreground="#727C91" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="⋮⋮" Foreground="#9AA2B3" FontSize="14" VerticalAlignment="Center" Margin="0,0,2,0" IsHitTestVisible="False" />
                                                    <Button Content="改" Tag="{Binding}" ToolTip="编辑" Style="{StaticResource ItemAction}" Click="EditApp_Click" />
                                                    <Button Content="删" Tag="{Binding}" ToolTip="删除" Style="{StaticResource ItemAction}" Foreground="#C24E5B" Click="DeleteApp_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TodoTab" Header="待办清单">
                    <local:TodoListView x:Name="TodoView" />
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="#EEF1F7" CornerRadius="0,0,18,18">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText"
                               Text="Ctrl+Alt+Space 显隐 · Ctrl+Alt+T 穿透"
                               Foreground="#79839A"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="MemoryText" Grid.Column="1" Text="内存 --"
                               Foreground="#9AA2B3"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
    </Grid>
</Window>
