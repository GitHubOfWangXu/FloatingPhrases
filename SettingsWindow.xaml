<Window Style="{DynamicResource {x:Type Window}}" x:Class="FloatingPhrases.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FloatingPhrases"
        Title="设置 · Floating Phrases" Width="480" Height="535" MinWidth="440" MinHeight="330"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Background="{DynamicResource BackgroundBrush}">
    <DockPanel Margin="22">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button Content="恢复默认快捷键" MinWidth="120" Height="34" Click="ResetHotkeys_Click" />
            <Button DockPanel.Dock="Right" Content="保存" Width="72" Height="34" IsDefault="True"
                    Click="Save_Click" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource CardBrush}" />
            <Button DockPanel.Dock="Right" Content="取消" Width="72" Height="34" Margin="0,0,8,0" IsCancel="True" />
        </DockPanel>
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="窗口与外观" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DockPanel Margin="0,3" LastChildFill="False">
                    <Label Content="窗口模式" Target="{Binding ElementName=ModeBox}" Padding="0" VerticalAlignment="Center" />
                    <ComboBox DockPanel.Dock="Right" x:Name="ModeBox" Width="145" MinHeight="32"
                              SelectionChanged="ModeBox_SelectionChanged">
                        <ComboBoxItem Content="普通" />
                        <ComboBoxItem Content="悬浮" />
                        <ComboBoxItem Content="穿透" />
                    </ComboBox>
                </DockPanel>
                <DockPanel Margin="0,3" LastChildFill="False">
                    <Label Content="界面主题" Target="{Binding ElementName=ThemeBox}" Padding="0" VerticalAlignment="Center" />
                    <ComboBox DockPanel.Dock="Right" x:Name="ThemeBox" Width="145" MinHeight="32">
                        <ComboBoxItem Content="shadcn" />
                        <ComboBoxItem Content="经典" />
                    </ComboBox>
                </DockPanel>
                <DockPanel Margin="0,3" LastChildFill="False">
                    <Label Content="闲置透明度" Target="{Binding ElementName=OpacitySlider}" Padding="0" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}" />
                    <Slider DockPanel.Dock="Right" x:Name="OpacitySlider" Width="103" MinHeight="32"
                            Minimum="20" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True" />
                </DockPanel>
                <Separator Margin="0,12,0,10" />
                <TextBlock Text="全局快捷键" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="选择组合键，或在按键框中直接按下快捷键。选「关闭」可停用对应快捷键。"
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
                <local:HotkeyPicker x:Name="VisibilityPicker" Tag="显示 / 隐藏" />
                <local:HotkeyPicker x:Name="ClickThroughPicker" Tag="鼠标穿透" />
                <local:HotkeyPicker x:Name="ScreenshotPicker" Tag="截图" />
                <local:HotkeyPicker x:Name="TranslationPicker" Tag="翻译剪贴板" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
