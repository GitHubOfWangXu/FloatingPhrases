<Window x:Class="FloatingPhrases.ScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        Background="Black"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Grid>
        <Image x:Name="ScreenImage" Stretch="Fill" SnapsToDevicePixels="True" />
        <Canvas x:Name="SelectionCanvas" Background="#18000000">
            <Border x:Name="SelectionBorder"
                    Visibility="Collapsed"
                    BorderBrush="#4B7BFF"
                    BorderThickness="2"
                    Background="#22FFFFFF">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.65" />
                </Border.Effect>
            </Border>
            <Border Canvas.Left="18"
                    Canvas.Top="18"
                    Padding="12,7"
                    Background="#CC17213B"
                    CornerRadius="7"
                    IsHitTestVisible="False">
                <TextBlock Text="拖拽选择截图区域 · Esc 取消"
                           Foreground="White"
                           FontSize="13" />
            </Border>
        </Canvas>
    </Grid>
</Window>
