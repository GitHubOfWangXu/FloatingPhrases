<Window Style="{DynamicResource {x:Type Window}}" x:Class="FloatingPhrases.ScreenshotHotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图快捷键" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="22">
        <TextBlock Text="选择组合键，或在按键框中直接按下快捷键。"
                   Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <CheckBox x:Name="CtrlBox" Content="Ctrl" Margin="0,0,12,0" VerticalAlignment="Center" />
            <CheckBox x:Name="AltBox" Content="Alt" Margin="0,0,12,0" VerticalAlignment="Center" />
            <CheckBox x:Name="ShiftBox" Content="Shift" Margin="0,0,12,0" VerticalAlignment="Center" />
            <ComboBox x:Name="KeyBox" Width="90" MinHeight="32" AutomationProperties.Name="按键"
                      DisplayMemberPath="Label" SelectedValuePath="Key" PreviewKeyDown="KeyBox_PreviewKeyDown" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource ForegroundBrush}" />
        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <Button Content="恢复默认" MinWidth="82" Height="34" Click="Reset_Click" />
            <Button DockPanel.Dock="Right" Content="保存" Width="72" Height="34" IsDefault="True"
                    Click="Save_Click" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource CardBrush}" />
            <Button DockPanel.Dock="Right" Content="取消" Width="72" Height="34" Margin="0,0,8,0" IsCancel="True" />
        </DockPanel>
    </StackPanel>
</Window>
