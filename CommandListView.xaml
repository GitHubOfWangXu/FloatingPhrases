<UserControl x:Class="FloatingPhrases.CommandListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4,12,4,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="38" Padding="12,8" BorderBrush="#D5DAE7" TextChanged="Search_Changed"
                     ToolTip="搜索命令名称、内容或工作目录" AutomationProperties.Name="搜索命令"/>
            <TextBlock Text="搜索命令" Foreground="#8B94A8" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
            <Button x:Name="AddButton" Grid.Column="2" Content="新增" Height="38" Background="#4462E8" Foreground="White" BorderThickness="0" Click="Add_Click"/>
        </Grid>
        <Grid Grid.Row="1">
            <TextBlock x:Name="EmptyHint" Text="还没有命令，点击新增保存常用命令" Foreground="#8B94A8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CommandList">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="White" BorderBrush="#E0E4EE" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,9">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#29344D" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12" Foreground="#727C91" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding WorkingDirectory}" Foreground="#727C91" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ShellName}" Foreground="#66718A" VerticalAlignment="Center" FontSize="11"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="运行" Tag="{Binding}" Width="44" Height="27" Background="#4462E8" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Run_Click" ToolTip="预览并确认后在终端执行"/>
                                        <Button Content="复制" Tag="{Binding}" Style="{DynamicResource ItemAction}" Width="40" Click="Copy_Click"/>
                                        <Button Content="改" Tag="{Binding}" Style="{DynamicResource ItemAction}" Click="Edit_Click" ToolTip="编辑命令"/>
                                        <Button Content="删" Tag="{Binding}" Style="{DynamicResource ItemAction}" Click="Delete_Click" ToolTip="删除命令入口" Foreground="#C24E5B"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <TextBlock x:Name="FeedbackText" Grid.Row="2" Text="运行前可核对命令；输出在终端查看。" Foreground="#79839A" TextWrapping="Wrap" Margin="0,6,0,8" FontSize="11"/>
    </Grid>
</UserControl>
