<UserControl x:Class="FloatingPhrases.HotkeyPicker" x:Name="Picker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="55" />
            <ColumnDefinition Width="55" />
            <ColumnDefinition Width="65" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <Label Content="{Binding Tag, ElementName=Picker}" Target="{Binding ElementName=KeyBox}"
               Padding="0" VerticalAlignment="Center" />
        <CheckBox Grid.Column="1" x:Name="CtrlBox" Content="Ctrl" VerticalAlignment="Center" />
        <CheckBox Grid.Column="2" x:Name="AltBox" Content="Alt" VerticalAlignment="Center" />
        <CheckBox Grid.Column="3" x:Name="ShiftBox" Content="Shift" VerticalAlignment="Center" />
        <ComboBox Grid.Column="4" x:Name="KeyBox" MinHeight="32" AutomationProperties.Name="{Binding Tag, ElementName=Picker}"
                  DisplayMemberPath="Label" SelectedValuePath="Key" PreviewKeyDown="KeyBox_PreviewKeyDown"
                  SelectionChanged="KeyBox_SelectionChanged" />
    </Grid>
</UserControl>
