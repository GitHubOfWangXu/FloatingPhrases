<UserControl x:Class="FloatingPhrases.TodoListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4,12,4,8" Background="#F8F9FD">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Height="38" Padding="9,8" VerticalContentAlignment="Center"
                     ToolTip="输入待办，按 Enter 添加；编辑时按 Escape 取消" KeyDown="Input_KeyDown"
                     AutomationProperties.Name="待办内容" BorderBrush="#D5DAE7" />
            <TextBlock Text="写下一件要做的事" Foreground="#8B94A8" Margin="10,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button x:Name="SaveButton" Grid.Column="1" Content="添加" Width="62" Margin="8,0,0,0"
                    Background="#4462E8" Foreground="White" BorderThickness="0" Click="Save_Click" />
            <Button x:Name="CancelButton" Grid.Column="2" Content="取消" Margin="6,0,0,0" Padding="6,0"
                    Visibility="Collapsed" Click="Cancel_Click" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,10,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="30" Padding="8,4" Margin="0,0,8,0"
                     ToolTip="搜索待办内容" AutomationProperties.Name="搜索待办" TextChanged="Filter_Changed" />
            <TextBlock Text="搜索待办…" Foreground="#8B94A8" Margin="9,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ComboBox x:Name="FilterBox" Grid.Column="1" SelectedIndex="0" VerticalContentAlignment="Center"
                      SelectionChanged="Filter_Changed" AutomationProperties.Name="待办状态筛选">
                <ComboBoxItem Content="全部" /><ComboBoxItem Content="未完成" /><ComboBoxItem Content="已完成" />
            </ComboBox>
        </Grid>
        <Grid Grid.Row="2">
            <TextBlock x:Name="EmptyHint" Text="还没有待办，先记下一件事吧" Foreground="#8B94A8"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TodoList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#E0E4EE" BorderThickness="1"
                                    CornerRadius="10" Padding="10,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" Tag="{Binding}" Click="Complete_Click"
                                              VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="标记完成或恢复未完成"
                                              AutomationProperties.Name="{Binding Text}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#29344D" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter Property="Foreground" Value="#8B94A8" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="2" Content="改" Tag="{Binding}" Click="Edit_Click" ToolTip="编辑待办"
                                            Background="Transparent" BorderThickness="0" Foreground="#65708A" Padding="6" />
                                    <Button Grid.Column="3" Content="删" Tag="{Binding}" Click="Delete_Click" ToolTip="删除待办，可撤销"
                                            Background="Transparent" BorderThickness="0" Foreground="#C24E5B" Padding="6" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <DockPanel>
                <Button x:Name="CopyButton" Content="复制清单" DockPanel.Dock="Right" Padding="8,3"
                        IsEnabled="False" Click="Copy_Click" AutomationProperties.Name="复制待办清单"
                        ToolTip="复制当前搜索和筛选结果，保留完成状态，可直接粘贴到工作日志" />
                <TextBlock x:Name="CountText" Foreground="#65708A" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <Button x:Name="UndoButton" Content="撤销删除" DockPanel.Dock="Right" Visibility="Collapsed"
                        Click="Undo_Click" Padding="8,3" />
                <TextBlock x:Name="FeedbackText" Foreground="#65708A" FontSize="11" TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
