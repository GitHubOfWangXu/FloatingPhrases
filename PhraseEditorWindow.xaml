<Window Style="{DynamicResource {x:Type Window}}" x:Class="FloatingPhrases.PhraseEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑短语"
        Width="430"
        Height="390"
        MinWidth="380"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="标题" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
        <TextBox x:Name="TitleBox"
                 Grid.Row="1"
                 Height="36"
                 Margin="0,7,0,14"
                 Padding="9,6"
                 BorderBrush="{DynamicResource BorderBrush}" />

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="分组" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                <TextBox x:Name="GroupBox"
                         Height="36"
                         Margin="0,7,0,0"
                         Padding="9,6"
                         BorderBrush="{DynamicResource BorderBrush}" />
            </StackPanel>
            <CheckBox x:Name="PinnedBox"
                      Grid.Column="2"
                      Content="置顶这条短语"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,9"
                      Foreground="{DynamicResource ForegroundBrush}" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="内容" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
            <TextBox x:Name="ContentBox"
                     Grid.Row="1"
                     Margin="0,7,0,0"
                     Padding="10"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     BorderBrush="{DynamicResource BorderBrush}" />
        </Grid>

        <StackPanel Grid.Row="4"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="取消" Width="82" Height="34" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button Content="保存"
                    Width="82"
                    Height="34"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="{DynamicResource CardBrush}"
                    BorderThickness="0"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
