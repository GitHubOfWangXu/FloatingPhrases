<Window x:Class="FloatingPhrases.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="英文 → 中文 · Floating Phrases" Icon="/FloatingPhrases;component/Assets/app.ico"
        Width="560" Height="680" MinWidth="460" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F7F8FC" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="BorderBrush" Value="#D8DDEA"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="复制英文后按 Ctrl+Alt+Y；仅主动翻译时发送文本到阿里云。"
                   TextWrapping="Wrap" Foreground="#65708A" Margin="0,0,0,14"/>
        <Label Grid.Row="1" Content="英文原文" Target="{Binding ElementName=SourceBox}" FontWeight="SemiBold" Foreground="#253047" Padding="0,0,0,6"/>
        <TextBox x:Name="SourceBox" Grid.Row="2" AutomationProperties.Name="英文原文"/>
        <Label Grid.Row="3" Content="中文译文" Target="{Binding ElementName=ResultBox}" FontWeight="SemiBold" Foreground="#253047" Padding="0,14,0,6"/>
        <TextBox x:Name="ResultBox" Grid.Row="4" AutomationProperties.Name="中文译文"/>
        <TextBlock x:Name="StatusText" Grid.Row="5" Text="请先复制英文，再按快捷键或点击翻译。"
                   TextWrapping="Wrap" Foreground="#65708A" Margin="0,12,0,10" AutomationProperties.LiveSetting="Polite"/>
        <Expander x:Name="KeySettings" Grid.Row="6" Header="API Key 配置（北京地域）" Margin="0,0,0,12">
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="使用百炼按量付费 API Key；与 Coding Plan 密钥不同。保存后仅当前 Windows 用户可解密，保存不会发起翻译。"
                           TextWrapping="Wrap" Foreground="#65708A" FontSize="12" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiKeyBox" Padding="8" MaxLength="512" AutomationProperties.Name="百炼 API Key"/>
                    <Button Grid.Column="1" Content="保存密钥" Margin="8,0,0,0" Click="SaveKey_Click"/>
                </Grid>
            </StackPanel>
        </Expander>
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Content="取消请求" HorizontalAlignment="Left" IsEnabled="False" Click="Cancel_Click"/>
            <Button x:Name="CopyButton" Grid.Column="1" Content="复制译文" Margin="0,0,8,0" IsEnabled="False" Click="Copy_Click"/>
            <Button x:Name="TranslateButton" Grid.Column="2" Content="翻译 / 重试" Background="#4462E8" Foreground="White" BorderThickness="0" Click="Translate_Click"/>
        </Grid>
    </Grid>
</Window>
